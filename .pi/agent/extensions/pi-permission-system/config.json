{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permission": {
    "*": "allow",
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/var/tmp": "allow",
      "/tmp/*": "allow",
      "/var/tmp/*": "allow",
      "~/.cache/*": "allow",
      "~/Downloads/*": "allow",
      "~/.local/share/*": "allow",
      "~/.npm/*": "allow",
      "~/.cargo/registry/*": "allow",
      "~/go/pkg/mod/*": "allow"
    },
    "external_directory_read": {
      "~/.pi/agent/*": "allow",
      "~/.local/*": "allow"
    },
    "bash": {
      "*": "allow",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf .": "deny",
      "rm -rf ..": "deny",
      "rm -rf /home/*": "deny",
      "rm -rf /etc/*": "deny",
      "rm -rf /usr/*": "deny",
      "rm -rf /var/*": "deny",
      "rm -rf /boot*": "deny",
      "rm -rf /root*": "deny",
      "rm -rf --no-preserve-root *": "deny",
      "mkfs *": "deny",
      "mkfs.*": "deny",
      "dd if=* of=/dev/*": "deny",
      "dd of=/dev/*": "deny",
      "shutdown *": "deny",
      "reboot": "deny",
      "halt": "deny",
      "poweroff": "deny",
      "systemctl poweroff": "deny",
      "systemctl reboot": "deny",
      "systemctl halt": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git reset --hard *": "deny",
      "git clean -fdx": "deny",
      "git clean -fd": "deny",
      "chmod -R 777 *": "deny",
      "chmod 777 *": "deny",
      "chown -R *": "deny",
      "sudo *": "ask",
      "doas *": "ask",
      "su *": "ask"
    }
  }
}
